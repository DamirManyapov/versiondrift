{
  // Solution root. `pnpm typecheck` (tsc -b) builds every package listed in "references"
  // (each package's tsconfig.json compiles src/ → dist/), then checks this project:
  // the root config files and every package's test/ directory.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.js", "packages/*/test", "apps/*/test"],
  // apps/web has its own tsconfig (SvelteKit, DOM types) and is checked by svelte-check.
  "exclude": ["apps/web"],
  "references": [
    { "path": "packages/schema" },
    { "path": "packages/core" },
    { "path": "packages/adapters" },
    { "path": "packages/classify" }
  ]
}
