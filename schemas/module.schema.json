{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versiondrift.dev/schemas/module.schema.json",
  "title": "VersionDrift product module",
  "description": "Hand-written draft. From S0-T2 on this file is generated from packages/schema (zod) — do not edit by hand after that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "versionScheme", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "vendor": { "type": "string" },
    "category": {
      "enum": ["os", "virtualization", "containers", "orchestration", "monitoring", "logging", "database", "mail",
               "network", "web", "security", "storage", "backup", "messaging", "collaboration", "ci-cd", "identity", "other"]
    },
    "homepage": { "type": "string", "format": "uri" },
    "logo": { "type": "string" },
    "description": { "type": "string", "maxLength": 200 },
    "versionScheme": { "enum": ["semver", "loose", "calver", "debian", "regex"] },
    "versionRegex": { "type": "string" },
    "tagFilter": {
      "type": "object", "additionalProperties": false,
      "properties": { "include": { "type": "string" }, "exclude": { "type": "string" } }
    },
    "prerelease": { "enum": ["skip", "include"], "default": "skip" },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "match"],
        "properties": { "id": { "type": "string" }, "match": { "type": "string" }, "label": { "type": "string" } }
      }
    },
    "defaultTrack": { "type": "string" },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["releases"],
      "properties": {
        "releases": { "$ref": "#/$defs/releaseSource" },
        "releasesExtra": { "type": "array", "items": { "$ref": "#/$defs/releaseSource" } },
        "security": { "type": "array", "items": { "$ref": "#/$defs/securitySource" } },
        "eol": { "$ref": "#/$defs/eolSource" }
      }
    },
    "classify": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sections": { "$ref": "#/$defs/typeMap" },
        "keywords": { "$ref": "#/$defs/typeMap" }
      }
    },
    "detect": { "type": "array", "items": { "$ref": "#/$defs/detectRule" } },
    "maintainers": { "type": "array", "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" } }
  },
  "allOf": [
    { "if": { "properties": { "versionScheme": { "const": "regex" } } }, "then": { "required": ["versionRegex"] } }
  ],
  "$defs": {
    "typeMap": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "security": { "type": "array", "items": { "type": "string" } },
        "breaking": { "type": "array", "items": { "type": "string" } },
        "deprecated": { "type": "array", "items": { "type": "string" } },
        "feature": { "type": "array", "items": { "type": "string" } },
        "fix": { "type": "array", "items": { "type": "string" } }
      }
    },
    "releaseSource": {
      "type": "object", "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "github" }, "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
            "useTags": { "type": "boolean" }, "notesFrom": { "enum": ["release", "changelogFile"] }, "changelogPath": { "type": "string" } },
          "required": ["repo"], "additionalProperties": false },
        { "properties": { "type": { "const": "gitlab" }, "host": { "type": "string" }, "project": { "type": "string" } },
          "required": ["project"], "additionalProperties": false },
        { "properties": { "type": { "const": "gitea" }, "host": { "type": "string" }, "repo": { "type": "string" } },
          "required": ["host", "repo"], "additionalProperties": false },
        { "properties": { "type": { "const": "rss" }, "url": { "type": "string", "format": "uri" },
            "versionFrom": { "enum": ["title", "link"] }, "versionRegex": { "type": "string" } },
          "required": ["url"], "additionalProperties": false },
        { "properties": { "type": { "const": "html" }, "url": { "type": "string", "format": "uri" },
            "select": { "type": "object", "required": ["item"], "additionalProperties": false,
              "properties": { "item": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" }, "date": { "type": "string" } } },
            "versionRegex": { "type": "string" }, "dateFormat": { "type": "string" } },
          "required": ["url", "select"], "additionalProperties": false },
        { "properties": { "type": { "const": "dockerhub" }, "repo": { "type": "string" }, "tagRegex": { "type": "string" } },
          "required": ["repo"], "additionalProperties": false },
        { "properties": { "type": { "const": "manual" }, "file": { "type": "string" } },
          "required": ["file"], "additionalProperties": false }
      ]
    },
    "securitySource": {
      "type": "object", "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "osv" }, "ecosystem": { "type": "string" }, "package": { "type": "string" } },
          "required": ["ecosystem", "package"], "additionalProperties": false },
        { "properties": { "type": { "const": "ghsa" }, "repo": { "type": "string" }, "ecosystem": { "type": "string" }, "package": { "type": "string" } },
          "additionalProperties": false },
        { "properties": { "type": { "const": "nvd" }, "cpe": { "type": "string", "pattern": "^cpe:2\\.3:" } },
          "required": ["cpe"], "additionalProperties": false },
        { "properties": { "type": { "const": "debian" },
            "packages": { "oneOf": [ { "type": "array", "items": { "type": "string" } }, { "const": "fromInventory" } ] } },
          "additionalProperties": false },
        { "properties": { "type": { "const": "rss" }, "url": { "type": "string", "format": "uri" } },
          "required": ["url"], "additionalProperties": false }
      ]
    },
    "eolSource": {
      "type": "object", "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "endoflife" }, "product": { "type": "string" } },
          "required": ["product"], "additionalProperties": false },
        { "properties": { "type": { "const": "manual" }, "file": { "type": "string" } },
          "required": ["file"], "additionalProperties": false }
      ]
    },
    "detectRule": {
      "type": "object", "minProperties": 1, "maxProperties": 1,
      "properties": {
        "http": { "type": "object", "required": ["path"],
          "properties": { "path": { "type": "string" }, "defaultPort": { "type": "integer" }, "scheme": { "enum": ["http", "https"] },
            "jsonPath": { "type": "string" }, "regex": { "type": "string" }, "header": { "type": "string" } } },
        "docker": { "type": "object", "required": ["image"], "properties": { "image": { "type": "string" } } },
        "command": { "type": "object", "required": ["run"], "properties": { "run": { "type": "string" }, "regex": { "type": "string" } } },
        "file": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "regex": { "type": "string" } } },
        "snmp": { "type": "object", "required": ["oid"], "properties": { "oid": { "type": "string" }, "regex": { "type": "string" } } },
        "sql": { "type": "object", "required": ["query"], "properties": { "engine": { "enum": ["mysql", "postgresql"] }, "query": { "type": "string" }, "regex": { "type": "string" } } }
      },
      "additionalProperties": false
    }
  }
}
