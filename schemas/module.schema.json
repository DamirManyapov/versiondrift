{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versiondrift.dev/schemas/module.schema.json",
  "title": "VersionDrift product module",
  "description": "Generated from packages/schema (zod) by `pnpm schema:gen`. Do not edit by hand.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Stable forever and equal to the file name. Renames need an `aliases` entry."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name."
    },
    "aliases": {
      "description": "Old ids and search synonyms.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "os",
        "virtualization",
        "containers",
        "orchestration",
        "monitoring",
        "logging",
        "database",
        "mail",
        "network",
        "web",
        "security",
        "storage",
        "backup",
        "messaging",
        "collaboration",
        "ci-cd",
        "identity",
        "other"
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "logo": {
      "description": "\"simpleicons:<slug>\" or a URL to an SVG in the repo.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "One line, at most 200 characters.",
      "type": "string",
      "maxLength": 200
    },
    "versionScheme": {
      "type": "string",
      "enum": [
        "semver",
        "loose",
        "calver",
        "debian",
        "regex"
      ],
      "description": "How versions are parsed and compared (docs/05)."
    },
    "versionRegex": {
      "type": "string",
      "minLength": 1,
      "format": "regex",
      "description": "Required for versionScheme: regex. Capture groups become numeric segments."
    },
    "branchGroups": {
      "description": "versionScheme: regex only: how many leading capture groups form the branch.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tagFilter": {
      "type": "object",
      "properties": {
        "include": {
          "type": "string",
          "minLength": 1,
          "format": "regex",
          "description": "Only raw versions matching this count as releases."
        },
        "exclude": {
          "type": "string",
          "minLength": 1,
          "format": "regex",
          "description": "Raw versions matching this are ignored."
        }
      },
      "additionalProperties": false
    },
    "prerelease": {
      "default": "skip",
      "type": "string",
      "enum": [
        "skip",
        "include"
      ]
    },
    "advisoryRanges": {
      "default": "osv",
      "description": "How advisory ranges without a lower bound read: osv (a union, \"< 8.3.32\" covers everything below), or per-branch (it covers its own line only, 8.3.x: the vendor lists every affected supported line, like PHP).",
      "type": "string",
      "enum": [
        "osv",
        "per-branch"
      ]
    },
    "releaseNotesUrl": {
      "description": "Per-release notes page, e.g. https://www.zabbix.com/rn/rn{version}; used as the release link.",
      "type": "string",
      "pattern": "^https?:\\/\\/\\S*\\{version\\}"
    },
    "tracks": {
      "description": "Parallel supported release lines users can pin (ES 8/9, Debian 12/13).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "defaultTrack": {
      "default": "latest",
      "description": "\"latest\" (any track) or a track id.",
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "properties": {
        "releases": {
          "anyOf": [
            {
              "$ref": "#/$defs/releaseSource"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/releaseSource"
              }
            }
          ],
          "description": "Where releases come from: one source, or several merged (the first to name a version wins; later ones fill in missing notes, dates and links)."
        },
        "releasesExtra": {
          "description": "Extra sources that enrich release notes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseSource"
          }
        },
        "security": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/securitySource"
          }
        },
        "eol": {
          "$ref": "#/$defs/eolSource"
        }
      },
      "required": [
        "releases"
      ],
      "additionalProperties": false
    },
    "classify": {
      "type": "object",
      "properties": {
        "sections": {
          "description": "Release-note headings that map to item types.",
          "$ref": "#/$defs/hintMap"
        },
        "keywords": {
          "description": "Keywords that mark an item as a type.",
          "$ref": "#/$defs/hintMap"
        }
      },
      "additionalProperties": false
    },
    "detect": {
      "description": "Version detectors; the first match wins.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/detectRule"
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9-]+$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "versionScheme",
    "sources"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "versionScheme": {
            "const": "regex"
          }
        },
        "required": [
          "versionScheme"
        ]
      },
      "then": {
        "required": [
          "versionRegex"
        ]
      }
    }
  ],
  "$defs": {
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Short and stable, e.g. \"12\" or \"7.0\". Quote numbers."
        },
        "match": {
          "type": "string",
          "minLength": 1,
          "format": "regex",
          "description": "Versions matching this belong to the track."
        },
        "current": {
          "description": "Instead of match: a URL naming the track's current version (an update channel); the track is that version's major.minor branch, re-read on every collection.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version; the first capture group wins."
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "label": {
          "description": "Shown next to the id, e.g. LTS or bookworm.",
          "type": "string",
          "minLength": 1
        },
        "group": {
          "description": "A product line the track belongs to (\"RouterOS 7\"): users pick the line, then the track (update channel) within it.",
          "type": "string",
          "minLength": 1
        },
        "prereleases": {
          "description": "Pre-releases count in this track (a testing channel with release candidates).",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "releaseSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "github"
            },
            "repo": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "useTags": {
              "description": "Read git tags instead of GitHub releases.",
              "type": "boolean"
            },
            "notesFrom": {
              "description": "Where release notes come from: the release body (default), a changelog file, or none (the body is an announcement; the notes link and advisories carry the content).",
              "type": "string",
              "enum": [
                "release",
                "changelogFile",
                "none"
              ]
            },
            "changelogPath": {
              "description": "Path of the changelog file for notesFrom: changelogFile.",
              "type": "string",
              "minLength": 1
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the tag name; tags that don't match are ignored. First non-empty capture group wins."
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gitlab"
            },
            "host": {
              "description": "Default: gitlab.com",
              "type": "string",
              "minLength": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "project"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gitea"
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "description": "Gitea or Forgejo instance, e.g. codeberg.org or code.forgejo.org"
            },
            "repo": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the tag name; tags that don't match are ignored. First non-empty capture group wins."
            }
          },
          "required": [
            "type",
            "host",
            "repo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rss"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "versionFrom": {
              "type": "string",
              "enum": [
                "title",
                "link"
              ]
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the entry; the first non-empty capture group wins."
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "html"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "select": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "item"
              ],
              "additionalProperties": false,
              "description": "CSS selectors: one `item` per release, the others relative to it."
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the item title (a table row: its cells joined by \" | \")."
            },
            "versionFormat": {
              "description": "Builds the version from versionRegex capture groups, e.g. \"$1-$2\" (version and build).",
              "type": "string",
              "minLength": 1
            },
            "dateFormat": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "url",
            "select"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dockerhub"
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "description": "Image repository, e.g. analogic/poste.io"
            },
            "tagRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Only tags matching this count as releases."
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the tag; the first non-empty capture group wins."
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manual"
            },
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "products/<id>.releases.yaml, maintained by hand."
            }
          },
          "required": [
            "type",
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "endoflife"
            },
            "product": {
              "type": "string",
              "minLength": 1,
              "description": "endoflife.date product slug"
            }
          },
          "required": [
            "type",
            "product"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pointer"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the text; the first capture group wins."
            },
            "epoch": {
              "description": "The text has a Unix time after the version: use it as the release date.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "notes"
            },
            "url": {
              "type": "string",
              "pattern": "^(https?:\\/\\/.*\\{(version|major|minor|patch|build)\\}|\\{url\\})",
              "description": "e.g. https://upgrade.mikrotik.com/routeros/{version}/CHANGELOG, …/relnotes/mysql/{major}.{minor}/en/news-{major}-{minor}-{patch}.html, or {url}"
            },
            "format": {
              "description": "Default: text",
              "type": "string",
              "enum": [
                "text",
                "markdown",
                "html"
              ]
            },
            "dialect": {
              "description": "Page layout to turn into notes: debian-announcement = the point release tables; microsoft-kb = a Windows update's KB article.",
              "type": "string",
              "enum": [
                "debian-announcement",
                "microsoft-kb"
              ]
            },
            "select": {
              "description": "CSS selector for the part of an HTML page that holds the notes (#docContent); its opening names the date if the release has none.",
              "type": "string",
              "minLength": 1
            },
            "perRun": {
              "description": "Notes fetched per run at most (default 200), for sites that throttle; releases still without notes follow in later runs, newest first.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "override": {
              "description": "Use these notes even when the release sources already gave some (a summary).",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "apt"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The Packages index, e.g. …/dists/trixie/pve-no-subscription/binary-amd64/Packages"
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "description": "Package name, e.g. pve-manager"
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version (e.g. drops the Debian revision \"-1\")."
            }
          },
          "required": [
            "type",
            "url",
            "package"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "debian-changelog"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "versionRegex": {
              "type": "string",
              "minLength": 1,
              "format": "regex",
              "description": "Extracts the version from the entry header."
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "changelog"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "dialect": {
              "type": "string",
              "enum": [
                "zabbix"
              ],
              "description": "The file layout: zabbix = \"Changes for X.Y.Z\" blocks with New features / Bug fixes."
            }
          },
          "required": [
            "type",
            "url",
            "dialect"
          ],
          "additionalProperties": false
        }
      ]
    },
    "securitySource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "osv"
            },
            "ecosystem": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "ecosystem",
            "package"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ghsa"
            },
            "repo": {
              "description": "Repository advisories. Alternative to ecosystem + package.",
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "ecosystem": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "repo"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "ecosystem"
                    ]
                  },
                  {
                    "required": [
                      "package"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "ecosystem",
                "package"
              ],
              "not": {
                "required": [
                  "repo"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "nvd"
            },
            "cpe": {
              "type": "string",
              "pattern": "^cpe:2\\.3:[aho]:"
            }
          },
          "required": [
            "type",
            "cpe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "msrc"
            },
            "products": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Product names as the Security Update Guide writes them, e.g. \"Windows Server 2022\"."
            },
            "months": {
              "description": "How far back advisories are read (default 6 months).",
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          "required": [
            "type",
            "products"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "debian"
            },
            "packages": {
              "anyOf": [
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                {
                  "type": "string",
                  "const": "fromInventory"
                }
              ],
              "description": "Source packages to track, or fromInventory to use the packages detected per host."
            }
          },
          "required": [
            "type",
            "packages"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rss"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "eolSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "endoflife"
            },
            "product": {
              "type": "string",
              "minLength": 1,
              "description": "endoflife.date product slug"
            },
            "cycles": {
              "description": "endoflife.date cycle → the version prefix it covers, when versions do not start with the cycle name (Windows Server: { \"2022\": \"20348\" }); other cycles are left out.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "type",
            "product"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manual"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "file"
          ],
          "additionalProperties": false
        }
      ]
    },
    "hintMap": {
      "type": "object",
      "properties": {
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "breaking": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deprecated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "detectRule": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\/"
            },
            "defaultPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "scheme": {
              "type": "string",
              "enum": [
                "http",
                "https"
              ]
            },
            "jsonPath": {
              "type": "string",
              "minLength": 1
            },
            "regex": {
